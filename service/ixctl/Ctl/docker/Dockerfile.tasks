# ixctl tasks image -- uv on oraclelinux:9-slim-fips (matches Dockerfile.service)
# built by `scripts/build.py service ixctl` (repository suffix -tasks)

ARG base_repo=oraclelinux
ARG base_tag=9-slim-fips
ARG python_ver=3.11

ARG install_to=/srv/service
ARG virtual_env=/venv
ARG uv_tag=latest
ARG uid=6300
ARG user=fullctl
ARG service_dir=service/ixctl

ARG build_deps=" \
    gcc \
    git \
    "
ARG run_deps=" \
    libpq \
    "
ARG debug_deps=" \
    tar \
    vim-minimal \
    "

FROM ghcr.io/astral-sh/uv:${uv_tag} AS uv

FROM ${base_repo}:${base_tag} AS base

ARG install_to
ARG virtual_env

# env to pass to sub images
ENV PYTHONUNBUFFERED=1
ENV SERVICE_HOME=$install_to
ENV VIRTUAL_ENV=$virtual_env
ENV UV_PROJECT_ENVIRONMENT=$virtual_env
ENV UV_PYTHON_DOWNLOADS=never
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# build container
FROM base AS builder

ARG build_deps
ARG python_ver
ARG service_dir

# TODO pin bgpq4
ARG bgpq4_version

# bgpq4 comes from EPEL (repo enabled via oracle-epel-release-el9)
RUN microdnf install -y python${python_ver} python${python_ver}-devel oracle-epel-release-el9 ${build_deps} \
    && microdnf install -y bgpq4 \
    && microdnf clean all

COPY --from=uv /uv /uvx /usr/local/bin/

WORKDIR /build

# For monorepo: copy fullctl source for path dependency resolution;
# the single root uv.lock covers all workspace members
COPY pyproject.toml uv.lock README.md ./
COPY src/ src/

# Set workdir to service directory (workspace member)
WORKDIR /build/${service_dir}

# Copy service files
COPY ${service_dir}/pyproject.toml ./

# service dependency set plus the tasks dependency group into /venv.
# --no-default-groups keeps the dev group out (uv installs it by default;
# the old poetry tasks images were built --only main,tasks)
RUN uv sync --frozen --no-install-project --no-editable --no-default-groups --group tasks

#### final image

FROM base AS final

ARG service_dir
ARG run_deps
ARG python_ver
ARG uid
ARG user

# extra settings file if needed
# TODO keep in until final production deploy
ARG COPY_SETTINGS_FILE=src/ixctl/settings/dev.py

# add dependencies
RUN microdnf install -y python${python_ver} shadow-utils ${run_deps} \
    && microdnf clean all

RUN useradd -l -u $uid $user

COPY --from=builder "$VIRTUAL_ENV" "$VIRTUAL_ENV"
COPY --from=builder /usr/bin/bgpq4 /usr/bin/bgpq4

WORKDIR $SERVICE_HOME
RUN mkdir -p etc locale media static
COPY ${service_dir}/Ctl/VERSION etc/
COPY ${service_dir}/docs/ docs

RUN chown -R $uid:$uid locale media

#### entry point from final image, not tester
FROM final

ARG service_dir
ARG debug_deps
ARG user
ARG uid
ARG ars_home=/arouteserver

#ENV UWSGI_SOCKET=127.0.0.1:6002

WORKDIR $SERVICE_HOME

# add debug dependencies
RUN microdnf install -y ${debug_deps} \
    && microdnf clean all

COPY ${service_dir}/src/ main/
COPY ${service_dir}/Ctl/docker/entrypoint.sh .

RUN ln -s "$SERVICE_HOME/entrypoint.sh" /entrypoint \
    && ln -s /venv "$SERVICE_HOME/venv"

COPY ${service_dir}/Ctl/docker/django-uwsgi.ini etc/
COPY ${service_dir}/Ctl/docker/manage.sh /usr/bin/manage


# this 777 will be replaced by 700 at runtime (allows semi-arbitrary "--user" values)
RUN mkdir -p "$ars_home" && chown -R $uid:$uid "$ars_home" && chmod 777 "$ars_home"
VOLUME ${ars_home}

USER $uid

ENTRYPOINT ["/entrypoint"]
CMD ["runserver"]
