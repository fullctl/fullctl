# prefixctl tasks image -- uv on oraclelinux:9-slim-fips (matches Dockerfile.service)
# built by `scripts/build.py service prefixctl` (repository suffix -tasks)

ARG base_repo=oraclelinux
ARG base_tag=9-slim-fips
ARG python_ver=3.11

ARG install_to=/srv/service
ARG virtual_env=/venv
ARG uv_tag=latest
ARG uid=6300
ARG user=fullctl
ARG service_dir=service/prefixctl

ARG build_deps=" \
    gcc \
    git \
    "
# bgpq4 comes from EPEL (repo enabled via oracle-epel-release-el9)
ARG run_deps=" \
    bgpq4 \
    "

FROM ghcr.io/astral-sh/uv:${uv_tag} AS uv

FROM ${base_repo}:${base_tag} AS base

ARG install_to
ARG virtual_env

# env to pass to sub images
ENV PYTHONUNBUFFERED=1
ENV SERVICE_HOME=$install_to
ENV VIRTUAL_ENV=$virtual_env
ENV UV_PROJECT_ENVIRONMENT=$virtual_env
ENV UV_PYTHON_DOWNLOADS=never
ENV PATH="$VIRTUAL_ENV/bin:$PATH"


# build container
FROM base AS builder

ARG build_deps
ARG python_ver
ARG service_dir

RUN microdnf install -y python${python_ver} python${python_ver}-devel ${build_deps} \
    && microdnf clean all

COPY --from=uv /uv /uvx /usr/local/bin/

WORKDIR /build

# For monorepo: copy fullctl source for path dependency resolution;
# the single root uv.lock covers all workspace members
COPY pyproject.toml uv.lock README.md ./
COPY src/ src/

# Set workdir to service directory (workspace member)
WORKDIR /build/${service_dir}

# Copy service files
COPY ${service_dir}/pyproject.toml ./

ARG extra_pip_install_dir

# service dependency set plus the tasks dependency group into /venv.
# --no-default-groups keeps the dev group out (uv installs it by default;
# the old poetry tasks images were built --only main,tasks)
RUN uv sync --frozen --no-install-project --no-editable --no-default-groups --group tasks

COPY ${service_dir}/Ctl/VERSION Ctl/

# gitignore is just a placeholder for if extra is empty
# this will trigger a cache invalidate
COPY ${service_dir}/.gitignore $extra_pip_install_dir ./plugins/
RUN test -z "$extra_pip_install_dir" || uv pip install ./plugins/*.tar.gz

#### final image

FROM base AS final

ARG service_dir
ARG run_deps
ARG run_dirs=".cache locale media static"
ARG python_ver
# playwright chromium dependencies (EL9 package names)
ARG playwright_deps=" \
    glib2 \
    nss \
    nspr \
    atk \
    at-spi2-atk \
    cups-libs \
    libdrm \
    dbus-libs \
    at-spi2-core \
    libX11 \
    libXcomposite \
    libXdamage \
    libXext \
    libXfixes \
    libXrandr \
    mesa-libgbm \
    libxcb \
    libxkbcommon \
    pango \
    cairo \
    alsa-lib \
    "
ARG uid
ARG user

# extra settings file if needed
# TODO keep in until final production deploy
ARG COPY_SETTINGS_FILE=mainsite/settings/dev.py

# add dependencies (bgpq4 from EPEL)
RUN microdnf install -y python${python_ver} shadow-utils oracle-epel-release-el9 \
    && microdnf install -y ${run_deps} ${playwright_deps} \
    && microdnf clean all

RUN useradd -l -u $uid $user

WORKDIR $SERVICE_HOME
COPY --from=builder "$VIRTUAL_ENV" "$VIRTUAL_ENV"

RUN mkdir -p etc $run_dirs
COPY ${service_dir}/Ctl/VERSION etc/
COPY ${service_dir}/docs/ docs

RUN chown -R $uid:$uid $run_dirs


#### entry point from final image, not tester
FROM final

ARG service_dir
ARG uid
ENV HOME=$SERVICE_HOME

COPY ${service_dir}/src/ main/
COPY ${service_dir}/Ctl/docker/entrypoint.sh .
RUN ln -s "$SERVICE_HOME/entrypoint.sh" /entrypoint
RUN ln -s /venv "$SERVICE_HOME/venv"

COPY ${service_dir}/Ctl/docker/django-uwsgi.ini etc/
COPY ${service_dir}/Ctl/docker/manage.sh /usr/bin/manage

#ENV UWSGI_SOCKET=127.0.0.1:6002

USER $uid
# installs to user home
RUN playwright install chromium

ENTRYPOINT ["/entrypoint"]
CMD ["runserver"]
